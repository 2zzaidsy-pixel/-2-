# Canonical site URL used for metadata, sitemap, robots, and Open Graph images.
# Leave unset to fall back to the default in src/data/site.ts
NEXT_PUBLIC_SITE_URL=https://zerotime.vercel.app

# --- Admin panel (server-only; never expose these to the client) ---
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=
# Random secret used to sign the admin session cookie (32+ chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Fine-grained GitHub token with Contents: Read and write on the repo below.
GITHUB_TOKEN=
# Repository that stores the content, in "owner/name" form.
GITHUB_REPO=2zzaidsy-pixel/-2-
# Branch that the site builds from.
GITHUB_BRANCH=main
      